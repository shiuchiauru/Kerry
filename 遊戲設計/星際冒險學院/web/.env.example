# 請從 Firebase Console → Project settings → Your apps → Web app 的 SDK 設定複製。
# Firebase Web API key 可公開；但 .env.local 仍不可提交到 Git。
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# App Check 的 reCAPTCHA v3「網站金鑰」，公開網站防濫用用。
# 在 https://www.google.com/recaptcha/admin 建立 v3 網站後取得。
# 網站金鑰可公開；「密鑰」只貼進 Firebase Console，不要放這裡。
# 留空則不啟用 App Check。
VITE_RECAPTCHA_SITE_KEY=
